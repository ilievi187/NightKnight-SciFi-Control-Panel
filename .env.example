# NightKnight Sci-Fi Control Center - Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# AI Agent Monitoring (optional)
# OpenCode
OPENCODE_ENDPOINT=http://127.0.0.1:4098
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=your-password-here

# Hermes Agent
HERMES_ENDPOINT=http://127.0.0.1:8642
HERMES_API_KEY=your-api-key-here

# Paperclip (requires Tailscale or local access)
PAPERCLIP_ENDPOINT=http://127.0.0.1:3100
PAPERCLIP_API_KEY=your-api-key-here

# Multi-host monitoring (optional)
# NIGHTKNIGHT_HOSTS=host1:8080,host2:8080
# NIGHTKNIGHT_HOST_TOKEN=your-token-here

# API authentication (optional, recommended for remote access)
# NIGHTKNIGHT_API_TOKEN=your-api-token-here
